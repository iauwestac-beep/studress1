# مسیر در مخزن: .github/workflows/build.yml
# مخزن فقط پوشه lib (سه فایل) + همین فایل را لازم دارد؛
# پروژه اندروید داخل خود GitHub ساخته می‌شود.
name: Build APK

on:
  workflow_dispatch:        # دکمه Run workflow
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Create Android project and copy code
        run: |
          flutter create --platforms android --org ir.dresscode --project-name dress_app app_tmp
          rm -rf app_tmp/lib app_tmp/test
          mkdir -p app_tmp/lib
          # فایل‌ها را می‌توانید در ریشه مخزن یا داخل پوشه lib بگذارید
          cp *.dart app_tmp/lib/ 2>/dev/null || true
          cp lib/*.dart app_tmp/lib/ 2>/dev/null || true
          # نام main_standalone.dart خودکار به main.dart تبدیل می‌شود
          if [ -f app_tmp/lib/main_standalone.dart ]; then mv app_tmp/lib/main_standalone.dart app_tmp/lib/main.dart; fi
          ls app_tmp/lib

      - name: Add packages
        working-directory: app_tmp
        run: |
          flutter pub add excel:^4.0.6 path_provider:^2.1.4 share_plus:^10.0.0 \
            shamsi_date:^1.1.1 sqflite_sqlcipher:^3.1.0 path:^1.9.0 uuid:^4.5.0 \
            flutter_secure_storage:^9.2.2 shared_preferences:^2.3.2 file_picker:^8.1.2
          flutter pub add flutter_localizations --sdk=flutter

      - name: Set minSdk 24
        working-directory: app_tmp
        run: |
          sed -i 's/minSdk = flutter.minSdkVersion/minSdk = 24/' android/app/build.gradle.kts 2>/dev/null || true
          sed -i 's/minSdkVersion flutter.minSdkVersion/minSdkVersion 24/' android/app/build.gradle 2>/dev/null || true

      - name: Set app label
        working-directory: app_tmp
        run: sed -i 's/android:label="[^"]*"/android:label="ثبت تخلف پوشش"/' android/app/src/main/AndroidManifest.xml

      - name: Build release APK
        working-directory: app_tmp
        run: flutter build apk --release

      - uses: actions/upload-artifact@v4
        with:
          name: dress-app-apk
          path: app_tmp/build/app/outputs/flutter-apk/app-release.apk
